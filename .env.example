# Copy to .env and fill in. Loaded via `node --env-file=.env` (see launchd plist and npm scripts).

# seats.aero Partner API key: seats.aero -> Settings -> API tab (Pro subscription required).
# Note: not every Pro account is granted the API tab; verify before annualizing.
SEATS_AERO_API_KEY=pro_xxxxxxxxxxxxxxxxxxxxx

# Twilio credentials for SMS alerts: console.twilio.com -> Account Info.
# You also need a Twilio phone number; put it (and your own number) in
# config.yaml under sms.from / sms.to as E.164 (e.g. +14165551234).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
